# Secrets — never commit
.env

# Local Claude Code settings (machine-specific permissions)
.claude/settings.local.json

# Data & vector stores — never commit (gitignore patterns can't have inline comments)
data/
qdrant_db/
qdrant_storage/
*.pkl
*.parquet

# Python
*.egg-info/
__pycache__/
*.pyc
*.pyo
.venv/
venv/
.ipynb_checkpoints/

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Eval run artefacts (machine-specific; the golden set itself is tracked)
eval/results/

# Misc
*.log
*.tmp
